# https://dashboard.privy.io -> your app -> App ID (public, ships in the bundle)
NEXT_PUBLIC_PRIVY_APP_ID=

# World Developer Portal. Both public.
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=send-free

# live once Selfie Check is enabled on the app, mock until then
IDENTITY_MODE=mock

# Signs attestations that users post to HumanRegistry. Server only.
ATTESTER_PRIVATE_KEY=
