# https://dashboard.privy.io -> your app -> App ID (public, ships in the bundle)
NEXT_PUBLIC_PRIVY_APP_ID=

# World ID Selfie Check app id. Public constant; live mode only. There is no
# public action variable alongside it: the action is signed into the
# rp_context by /api/world/context (WORLD_ACTION below) and the browser reads
# it back from there, so it is set in exactly one place.
NEXT_PUBLIC_WORLD_APP_ID=

# Which World backend IDKit targets. Unset or empty defaults to "production" —
# idkit-core's own default, and what every deployment used before this
# variable existed. Set to exactly "sandbox" to test against a Sandbox World
# App build (TestFlight / a private Play track); World refuses a mismatched
# pairing, so a sandbox app talking to a production-targeted request fails
# the selfie. "staging" is also accepted (idkit-core's third option) but
# unused by this app. Any other value is a hard configuration error, on
# purpose — see requireWorldEnvironment in web/src/lib/world-id.ts.
NEXT_PUBLIC_WORLD_ENVIRONMENT=

# World Developer Portal. app_id and rp_id are public; live mode only.
WORLD_RP_ID=

# Signs the rp_context sent to World ID. Kept on the server, live mode only.
WORLD_RP_SIGNING_KEY=

# World ID action. Signed into the rp_context /api/world/context returns and
# read from there by the browser — not duplicated as a NEXT_PUBLIC_ variable,
# since two independently-set copies of the same value is how they used to
# drift apart silently. Live mode only.
WORLD_ACTION=

# Selfie Check mode. Unset or empty defaults to mock (safe for local development).
# Set to exactly "live" to use real World ID (requires all WORLD_* and
# NEXT_PUBLIC_WORLD_* variables above), or exactly "mock" to be explicit.
# Any other value is a hard configuration error and will crash the challenge page
# (/c/[token]) for all senders, including paying ones. Whitespace is not trimmed:
# IDENTITY_MODE=live (with trailing space) will throw, not downgrade to mock.
IDENTITY_MODE=

# Signs attestations that users post to HumanRegistry. Server only.
ATTESTER_PRIVATE_KEY=

# gateway. Shared with the mail worker, and the only thing standing between the
# release endpoint and anyone who finds it.
MAIL_WEBHOOK_SECRET=

# The mail worker, which holds every message that is waiting for its sender to
# answer and is the only thing that can put the original bytes back on the wire.
# Its workers.dev URL, no trailing slash.
MAIL_WORKER_URL=https://postage-mail.<your-subdomain>.workers.dev

# Keys the onchain message id. Everything the id names is guessable, so a plain
# hash of it would let anyone confirm who wrote to whom by searching preimages.
MESSAGE_ID_SECRET=
APP_URL=http://localhost:3210

# file: for local, libsql://... for Turso
DATABASE_URL=file:.data/postage.db
DATABASE_AUTH_TOKEN=

# Optional. Unset, viem uses the public RPC in Arc's chain definition, which is
# shared with everyone else using it. Every held message reads effectiveFloor, so
# a gateway carrying real mail wants an endpoint of its own.
ARC_RPC_URL=

# subgraph
GRAPH_QUERY_URL=
GRAPH_API_KEY=
RELAYER_PRIVATE_KEY=
CLASSIFIER_PRIVATE_KEY=
ANTHROPIC_API_KEY=

# Cloudflare Email Routing. The token needs Email Routing Addresses Write, and
# is what registers a new user's forwarding address so message.forward() will
# accept it. Registering also makes Cloudflare send its verification mail.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Resend, for the code that proves a claimer can read an address Privy has not
# already checked, and for a message pasted back in after a hold ran out. The
# mail asking a sender who they are does not go through this - it is a reply
# inside the SMTP session the worker is already holding open.
# MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Postage <hello@usepostage.com>
