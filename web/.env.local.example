# https://dashboard.privy.io -> your app -> App ID (public, ships in the bundle)
NEXT_PUBLIC_PRIVY_APP_ID=

# World Developer Portal. app_id and rp_id are public.
WORLD_RP_ID=
WORLD_ACTION=send-free

# Secret. Signs the rp_context that every World ID 4.0 proof request carries.
WORLD_RP_SIGNING_KEY=

# live once Selfie Check is enabled on the app, mock until then
IDENTITY_MODE=mock

# Signs attestations that users post to HumanRegistry. Server only.
ATTESTER_PRIVATE_KEY=

# gateway. Shared with the mail worker, and the only thing standing between the
# release endpoint and anyone who finds it.
MAIL_WEBHOOK_SECRET=

# The mail worker, which holds every message that is waiting for its sender to
# answer and is the only thing that can put the original bytes back on the wire.
# Its workers.dev URL, no trailing slash.
MAIL_WORKER_URL=https://postage-mail.<your-subdomain>.workers.dev

# Keys the onchain message id. Everything the id names is guessable, so a plain
# hash of it would let anyone confirm who wrote to whom by searching preimages.
MESSAGE_ID_SECRET=
APP_URL=http://localhost:3210

# file: for local, libsql://... for Turso
DATABASE_URL=file:.data/postage.db
DATABASE_AUTH_TOKEN=

# subgraph
GRAPH_QUERY_URL=
GRAPH_API_KEY=
RELAYER_PRIVATE_KEY=
CLASSIFIER_PRIVATE_KEY=
ANTHROPIC_API_KEY=

# Cloudflare Email Routing. The token needs Email Routing Addresses Write, and
# is what registers a new user's forwarding address so message.forward() will
# accept it. Registering also makes Cloudflare send its verification mail.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Resend, for the code that proves a claimer can read an address Privy has not
# already checked, and for a message pasted back in after a hold ran out. The
# mail asking a sender who they are does not go through this - it is a reply
# inside the SMTP session the worker is already holding open.
# MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Postage <hello@usepostage.com>
